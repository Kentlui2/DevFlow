# Supabase project settings — Project Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed for server-side admin operations (migrations, seed scripts).
# Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App settings for per-user repository access (server-only secrets).
# Register a public GitHub App with read-only Contents, Issues, and Pull requests permissions.
# Set its Setup URL and Callback URL to the matching paths on your DevFlow deployment.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Store the PEM private key as a server-side secret; use escaped newlines if the host requires one line.
# Never use a NEXT_PUBLIC_ prefix.
GITHUB_APP_PRIVATE_KEY=
